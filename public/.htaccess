#-----------------------------------------------------------

#Répertoire : /

#-----------------------------------------------------------

#Le serveur doit suivre les liens symboliques :

Options +FollowSymlinks

#Activation du module de réécriture d'URL :

RewriteEngine on

#-----------------------------------------------------------
#ROUTES PINCIPALE

# LISTE DES PROJETS
# PATTERN: /projects      (page suivante : /projects?page=2)
# RÉÉCRITE EN: index.php?projects=index
# ACTION: indexAction
RewriteRule ^projects/?$ index.php?projects=index [L,QSA]

#-----------------------------------------------------------

#ROUTES

# AJOUT : FORMULAIRE
# PATTERN: /projects/add/form.html
# RÉÉCRITE EN: index.php?projects=addForm
# ACTION: addFormAction
RewriteRule ^projects/add/form\.html$ index.php?projects=addForm [L]

# AJOUT : ENREGISTREMENT (méthode POST)
# PATTERN: /projects/add/insert.html
# RÉÉCRITE EN: index.php?projects=addInsert
# ACTION: addInsertAction
RewriteRule ^projects/add/insert\.html$ index.php?projects=addInsert [L]

# SUPPRESSION D'UN PROJET
# PATTERN: /projects/delete/id/slug.html
# RÉÉCRITE EN: index.php?projects=delete&id=x
# ACTION: deleteAction
RewriteRule ^projects/delete/([0-9]+)/([^/]+)\.html$ index.php?projects=delete&id=$1 [L]

# DÉTAIL D'UN PROJET (en dernier : c'est le pattern le plus général)
# PATTERN: /projects/id/slug.html
# RÉÉCRITE EN: index.php?projects=show&id=x
# ACTION: showAction
RewriteRule ^projects/([0-9]+)/([^/]+)\.html$ index.php?projects=show&id=$1 [L]

#-----------------------------------------------------------
