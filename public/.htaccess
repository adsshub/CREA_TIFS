#-----------------------------------------------------------

#Répertoire : /

#-----------------------------------------------------------

#Le serveur doit suivre les liens symboliques :

Options +FollowSymlinks

#Activation du module de réécriture d'URL :

RewriteEngine on

#-----------------------------------------------------------
#ROUTES PINCIPALE

# LISTE DES PROJETS
# PATTERN: /projects      (page suivante : /projects?page=2)
# RÉÉCRITE EN: index.php?projects=index
# ACTION: indexAction
RewriteRule ^projects/?$ index.php?projects=index [L,QSA]

#-----------------------------------------------------------

#ROUTES

#-----------------------------------------------------------
